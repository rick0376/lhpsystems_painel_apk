generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AdminRole {
  SUPERADMIN
  ADMIN
}

model Admin {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         AdminRole @default(ADMIN)
  active       Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AppProject {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  appKey      String  @unique
  description String?

  supportWhatsappLabel   String?
  supportWhatsappNumber  String?
  supportWhatsappMessage String?

  active Boolean @default(true)

  apkUsers    ApkUser[]
  radioConfig RadioStreamConfig?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RadioStreamConfig {
  id String @id @default(cuid())

  projectId String     @unique
  project   AppProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  host                    String
  sourcePort              Int
  publicPort              Int?
  playerUrl               String?
  sourceUsername          String  @default("live")
  sourcePasswordEncrypted String
  mountPoint              String  @default("/")
  useTls                  Boolean @default(false)
  enabled                 Boolean @default(true)
  bitrate                 Int     @default(128)
  sampleRate              Int     @default(44100)
  channels                Int     @default(2)
  version                 Int     @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ApkUser {
  id String @id @default(cuid())

  projectId String
  project   AppProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name         String
  username     String
  passwordHash String

  active Boolean @default(true)

  expiresAt DateTime?

  canTransmit        Boolean @default(true)
  canOpenSettings    Boolean @default(true)
  canEditRadioConfig Boolean @default(true)

  // Permissões do LHP Radio Manager
  canAccessRadioManager     Boolean @default(false)
  canViewRadioDashboard     Boolean @default(false)
  canManageAutoDj           Boolean @default(false)
  canViewRadioLibrary       Boolean @default(false)
  canUploadRadioTracks      Boolean @default(false)
  canDeleteRadioTracks      Boolean @default(false)
  canManageRadioPlaylists   Boolean @default(false)
  canManageRadioSchedules   Boolean @default(false)
  canManageRadioIntervals   Boolean @default(false)
  canManageRadioSettings    Boolean @default(false)
  canViewRadioAudit         Boolean @default(false)

  maxDevices Int @default(1)

  notes String?

  devices Device[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, username])
  @@index([projectId])
}

model Device {
  id String @id @default(cuid())

  apkUserId String
  apkUser   ApkUser @relation(fields: [apkUserId], references: [id], onDelete: Cascade)

  deviceId   String
  deviceName String?

  active       Boolean   @default(true)
  lastAccessAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([apkUserId, deviceId])
}
