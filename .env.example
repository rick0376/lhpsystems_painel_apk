# .env.example

# Banco PostgreSQL Neon
DATABASE_URL="postgresql://usuario:senha@host/database?sslmode=require"

# Chave secreta para autenticação do painel
JWT_SECRET="troque-essa-chave-por-uma-chave-grande-e-segura"

# Admin inicial do painel
ADMIN_NAME="Administrador"
ADMIN_EMAIL="admin@email.com"
ADMIN_PASSWORD="troque-por-uma-senha-com-12-ou-mais-caracteres"

# Token assinado utilizado pelos aplicativos (pode ser diferente do JWT do painel)
APK_JWT_SECRET="troque-por-outra-chave-grande-e-segura"

# Chave usada para criptografar senhas DJ no banco (mínimo 32 caracteres)
# Não altere depois de cadastrar as senhas, ou será necessário cadastrá-las novamente.
RADIO_CONFIG_ENCRYPTION_KEY="troque-por-uma-chave-com-pelo-menos-32-caracteres"

# O Radio Manager usa as mesmas rotas de autenticação do painel.
# Crie um projeto com appKey: lhp_radio_manager_2026
